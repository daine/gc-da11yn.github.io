{% set branch = "main" %}
{% from "macros/contentType.njk" import getContentType %}
{% from "macros/dialog.njk" import dialogButton, dialog with context %}

{#
  Page list table (GCDS)
  - WET table plugins (wb-tables, wb-tagfilter) replaced by gcds-table, which provides
    the keyword filter, column sorting and pagination.
  - "Visible columns" and page-type filters moved into a dialog (macros/dialog.njk)
    and applied by src/_scripts/page-list-table.js.
  - gcds-table renders with JavaScript only. Without JavaScript, the CSV export
    remains available as the complete fallback.
#}

{% set en = locale === "en" %}
{% set columns = [
	{ field: "title", header: ("Title" if en else "Titre"), slotted: true, sort: true, rowHeader: true },
	{ field: "tags", header: pageList[locale].tagsText, sort: true },
	{ field: "subject", header: pageList[locale].subjectsText, sort: true },
	{ field: "role", header: ("Role" if en else "Rôle"), sort: true },
	{ field: "layout", header: ("Layout" if en else "Mise en page"), sort: true },
	{ field: "modified", header: ("Date modified" if en else "Date de modification"), sort: true, sortDirection: "desc" },
	{ field: "created", header: ("Date created" if en else "Date de création"), sort: true },
	{ field: "type", header: ("Content type" if en else "Type de contenu"), sort: true },
	{ field: "file", header: ("Link to file" if en else "Lien vers le fichier"), slotted: true }
] %}

{% set columnOptions = [] %}
{% for column in columns %}
	{% set columnOptions = (columnOptions.push({ id: "column-" + column.field, label: column.header, value: column.field, checked: true }), columnOptions) %}
{% endfor %}
{% set pageTypeOptions = [
	{ id: "page-type-landing", label: pageList[locale].landingPagesText, value: "landing", checked: true },
	{ id: "page-type-content", label: pageList[locale].contentPagesText, value: "content", checked: true }
] %}

{% set rows = [] %}
{% for entry in entries | sort(false, false, 'data.title') %}
	{% if entry.data.locale == locale and not entry.data.redirect and not entry.inputPath.endsWith('.csv.njk') %}
		{% set newPath = entry.inputPath | replace("\./", "/") %}
		{% set contentType %}{{ getContentType(entry.inputPath, locale) }}{% endset %}
		{% if not entry.data.role %}{% set roleList = [] %}{% elif entry.data.role is string %}{% set roleList = [entry.data.role] %}{% else %}{% set roleList = entry.data.role %}{% endif %}
		{% if not entry.data.subject %}{% set subjectList = [] %}{% elif entry.data.subject is string %}{% set subjectList = [entry.data.subject] %}{% else %}{% set subjectList = entry.data.subject %}{% endif %}
		{% set rows = (rows.push({
			title: entry.data.title | striptags(true),
			url: entry.url,
			tags: (entry.data.tags | join(", ")) if entry.data.tags else "",
			subject: subjectList | join(", "),
			role: roleList | join(", "),
			layout: entry.data.layout or "",
			modified: (entry.date | postDate) if entry.date else "",
			created: (entry.data.gitCreated | postDate) if entry.data.gitCreated else "",
			type: contentType,
			file: newPath,
			fileUrl: "https://github.com/gc-da11yn/gc-da11yn.github.io/tree/" + branch + newPath,
			pageType: "landing" if "/main/" in entry.inputPath else "content"
		}), rows) %}
	{% endif %}
{% endfor %}

</gcds-container>
<gcds-container layout="full" padding="300">

	<div class="d-flex flex-wrap align-items-center gap-300 mb-300">
		<gcds-link href="{{ pathPrefix }}/docs/pages-{{ locale }}.csv" download>{{ pageList[locale].downloadCsvText }}</gcds-link>
		<div id="page-list-table-controls" class="d-flex flex-wrap gap-200" hidden>
			{{ dialogButton("page-list-table-definitions", pageList[locale].definitionButtonText) }}
			{{ dialogButton("page-list-table-options", pageList[locale].tableOptionsButton) }}
		</div>
	</div>

	{% call dialog("page-list-table-definitions", pageList[locale].definitionButtonText, locale) %}
		{% set showRoles = true %}
		{% include "partials/labelDefinitions.njk" %}
	{% endcall %}

	{% call dialog("page-list-table-options", pageList[locale].tableOptionsButton, locale) %}
		<gcds-checkboxes
			id="page-list-table-columns"
			class="mb-300"
			name="page-list-table-columns"
			legend="{{ pageList[locale].columnsLegend }}"
			options="{{ columnOptions | dump | escape }}"
		></gcds-checkboxes>
		<gcds-checkboxes
			id="page-list-table-types"
			name="page-list-table-types"
			legend="{{ pageList[locale].pageTypesLegend }}"
			options="{{ pageTypeOptions | dump | escape }}"
		></gcds-checkboxes>
	{% endcall %}

	<gcds-table
		id="page-list-table"
		filter
		sort
		pagination
		pagination-size="25"
		columns="{{ columns | dump | escape }}"
		data="{{ rows | dump | escape }}"
	>
		<span slot="caption">{{ pageList[locale].tableCaption }}</span>
		<template slot="cell:title"><gcds-link data-bind-template-href="{url}" data-bind="title"></gcds-link></template>
		<template slot="cell:file"><code><gcds-link data-bind-template-href="{fileUrl}" data-bind="file"></gcds-link></code></template>
	</gcds-table>

	<noscript><p>{{ pageList[locale].noScriptText }}</p></noscript>

</gcds-container>
<gcds-container layout="page" padding="300">

<script src="{{ pathPrefix }}/js/dialog.js" defer></script>
<script src="{{ pathPrefix }}/js/page-list-table.js" defer></script>
