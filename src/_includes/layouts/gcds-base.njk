{% if redirect %}
{% include "partials/gcds/redirect.njk" %}
{% else %}

<!DOCTYPE html>
<html class="no-js" lang="{{ locale }}" dir="ltr">

	{% include "partials/gcds/head.njk" %}

	<body vocab="http://schema.org/" typeof="WebPage">

		{%- if archived -%}
			{%- include "partials/gcds/archived.njk" -%}
		{%- endif -%}

		{% include "partials/gcds/header.njk" %}

		<main property="mainContentOfPage" resource="#wb-main" typeof="WebPageElement" id="main">

		{% block content %}
			<gcds-container layout="full" class="banner">
			  <gcds-container layout="page" padding="200">
				<gcds-grid columns="1fr" columns-desktop="4fr 1fr" class="py-150">
				  <div class="banner__box">
					<gcds-heading tag="h1" property="name" heading-role="light">
						{%- if archived -%}
							{{ archiveStrings[locale].archivedTitle }}
						{%- endif -%}
						{{ title | safe }}
					</gcds-heading>
					{% if description %}
					<p>{{ description | safe }}</p>
					{% else %}
					<p><strong>{{ landingPage[locale].descriptionNoneText }}</strong></p>
					{% endif %}
					{%- if role -%}
					<hr />
					<h2 class="h6">Related roles:</h2>
					<ul class="list-inline">
						{% for key in role %}
						<li class="label label-success">
							{{ roles.labels[locale][key] or key }}
						</li>
						{% endfor %}
					</ul>
					{%- endif -%}
				  </div>
				</gcds-grid>
			  </gcds-container>
			</gcds-container>

			{% include "partials/gcds/alerts.njk" %}

			<gcds-container layout="page" padding="300">
				{% if officeTOC === true %}
				{% include "partials/office-toc.njk" %}
				{% include "partials/gcds/office365Notice.njk" %}
				{% endif %}

				{% if hasDocument %}
				{% include "partials/download.njk" %}
				{% endif %}

				{% if toc or tocSimple %}
				{% include "partials/onThisPage.njk" %}
				{% endif %}

				{{ content | safe }}
				{% if officeTOC === true %}
				{% include "partials/office-toc.njk" %}
				{% endif %}
			</gcds-container>

			{% include "partials/gcds/pagedetails.njk" %}

		{% endblock %}
		</main>

		{% include "partials/gcds/contribute.njk" %}

		{% include "partials/gcds/footer.njk" %}

		{#- No WET, jQuery or chart runtime on GCDS pages. The analytics chart moves in Work Package 12. -#}

		{%- if settings.env == "dev" or settings.env == "local" -%}
			{% set gcdsLayout = true %}
			{% include "partials/sa11y.njk" %}
		{%- endif -%}
	</body>

</html>

{% endif %}
